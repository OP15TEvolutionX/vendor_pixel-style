runtime_resource_overlay {
    name: "PixelLauncherOverlayCustom",
    certificate: "platform",
    // A separate resource package keeps launcher IDs absolute when the RRO is loaded.
    // Resolve PixelLauncher attributes and preserve references to its stock resources.
    aaptflags: [
        "--package-id", "0x7e",
        "--allow-reserved-package-id",
        "-I", "vendor/gms/system_ext/packages/privileged_apps/NexusLauncherRelease/NexusLauncherRelease.apk",
    ],
    sdk_version: "current",
    product_specific: true,
}
